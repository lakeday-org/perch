{
  "name": "perch-fixture-order-service-jest",
  "private": true,
  "scripts": { "build": "tsc", "start": "node dist/main.js", "test": "jest" },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/node": "^22.10.0",
    "jest": "^30.0.0",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.ts"],
    "reporters": ["default", "jest-junit"]
  },
  "jest-junit": {
    "addFileAttribute": "true",
    "ancestorSeparator": " > ",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  }
}
