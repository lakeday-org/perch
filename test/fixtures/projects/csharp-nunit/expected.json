    },
    {
      "file": "Stockroom.Tests/WarehouseTests.cs",
      "name": "ReservesEveryLineOrNone",
      "reaches": ["Stockroom/Warehouse.cs::Warehouse.Warehouse", "Stockroom/Warehouse.cs::Warehouse.Stock", "Stockroom/Warehouse.cs::Warehouse.Reserve", "Stockroom/Warehouse.cs::Warehouse.LevelOf", "Stockroom/StockLevel.cs::StockLevel.Available"]
    },
    {
      "file": "Stockroom.Tests/WarehouseTests.cs",
