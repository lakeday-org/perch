    },
    {
      "file": "Stockroom.Tests/SkuTests.cs",
      "name": "RejectsCodesItCannotBook",
      "reaches": ["Stockroom/Sku.cs::Sku.Parse"]
    },
    {
      "file": "Stockroom.Tests/SkuTests.cs",
      "name": "TwoSkusWithOneCodeAreEqual",
      "reaches": ["Stockroom/Sku.cs::Sku.Parse"]
    },
    {
      "file": "Stockroom.Tests/StockLevelTests.cs",
      "name": "ReservingLeavesLessAvailable",
      "reaches": ["Stockroom/StockLevel.cs::StockLevel.StockLevel", "Stockroom/StockLevel.cs::StockLevel.Reserve", "Stockroom/StockLevel.cs::StockLevel.Available", "Stockroom/Sku.cs::Sku.Parse"]
    },
    {
      "file": "Stockroom.Tests/StockLevelTests.cs",
      "name": "CannotReserveMoreThanIsAvailable",
