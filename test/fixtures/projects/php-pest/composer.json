{
  "name": "acme/booking",
  "description": "Rooms, reservations and a cancellation policy",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "pestphp/pest": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Acme\\Booking\\": "src/"
    }
  },
  "autoload-dev": {
    "files": ["tests/Pest.php"]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest"
  }
}
