{
  "language": "typescript",
  "framework": "Vitest",
  "reports": {
    "junit": ["reports/junit.xml"],
    "lcov": ["reports/lcov.info"]
  },
  "left_out": [
    "scripts/bench.ts",
    "scripts/check-exports.ts",
    "examples/basic.ts",
    "examples/router.ts",
    "docs/.vitepress/config.ts",
    "vitest.config.ts"
  ],
  "tests": [
    { "file": "test/parse.test.ts", "name": "reads a flat query", "status": "passed",
      "reaches": ["src/parse.ts::parse", "src/parse.ts::splitPair", "src/options.ts::parseOptions", "src/encode.ts::decodeComponent"] },
    { "file": "test/parse.test.ts", "name": "parses %s as %s", "status": "passed",
      "reaches": ["src/parse.ts::parse", "src/format/nested.ts::splitKey"] },
    { "file": "test/parse.test.ts", "name": "nests bracketed keys", "status": "passed",
      "reaches": ["src/parse.ts::parse", "src/format/nested.ts::splitKey", "src/format/nested.ts::assignPath"] },
    { "file": "test/parse.test.ts", "name": "rejects a negative depth", "status": "passed",
      "reaches": ["src/parse.ts::parse", "src/options.ts::parseOptions"] },
    { "file": "test/parse.test.ts", "name": "turns numbers into numbers when asked", "status": "passed",
      "reaches": ["src/parse.ts::parse", "src/parse.ts::coerce"] },
    { "file": "test/parse.test.ts", "name": "rejects an empty key", "status": "passed",
      "reaches": ["src/parse.ts::parse", "src/errors.ts::QueryError.constructor"] },

    { "file": "test/stringify.test.ts", "name": "writes a flat object", "status": "passed",
      "reaches": ["src/stringify.ts::stringify", "src/options.ts::stringifyOptions", "src/format/nested.ts::flatten", "src/stringify.ts::encodeKey", "src/stringify.ts::scalar"] },
    { "file": "test/stringify.test.ts", "name": "encodes reserved characters in keys and values", "status": "passed",
      "reaches": ["src/stringify.ts::stringify", "src/stringify.ts::encodeKey", "src/encode.ts::encodeComponent"] },
    { "file": "test/stringify.test.ts", "name": "writes arrays in each format", "status": "passed",
      "reaches": ["src/stringify.ts::stringify", "src/format/array.ts::formatArray"] },
    { "file": "test/stringify.test.ts", "name": "warns about a legacy array format name", "status": "passed",
      "reaches": ["src/stringify.ts::stringify", "src/options.ts::stringifyOptions", "src/options.ts::resolveArrayFormat"] },
    { "file": "test/stringify.test.ts", "name": "${t.name} survives a round trip", "status": "passed",
      "reaches": ["src/stringify.ts::stringify", "src/parse.ts::parse"] },

    { "file": "test/encode.test.ts", "name": "encodes $input", "status": "passed",
      "reaches": ["src/encode.ts::encodeComponent"] },
    { "file": "test/encode.test.ts", "name": "turns plus signs into spaces", "status": "passed",
      "reaches": ["src/encode.ts::decodeComponent"] },
    { "file": "test/encode.test.ts", "name": "tells an encoded string from a plain one", "status": "passed",
      "reaches": ["src/encode.ts::isEncoded", "src/encode.ts::decodeComponent"] },

    { "file": "test/search-params.test.ts", "name": "reads the first value of a key", "status": "passed",
      "reaches": ["src/search-params.ts::SearchParams.constructor", "src/search-params.ts::SearchParams.get"] },
    { "file": "test/search-params.test.ts", "name": "replaces every value of a key with set", "status": "passed",
      "reaches": ["src/search-params.ts::SearchParams.constructor", "src/search-params.ts::SearchParams.set", "src/search-params.ts::SearchParams.getAll", "src/search-params.ts::SearchParams.toString"] },
    { "file": "test/search-params.test.ts", "name": "deletes one value or all of them", "status": "passed",
      "reaches": ["src/search-params.ts::SearchParams.delete", "src/search-params.ts::SearchParams.has"] },
    { "file": "test/search-params.test.ts", "name": "sorts by key and keeps the order of equal keys", "status": "passed",
      "reaches": ["src/search-params.ts::SearchParams.append", "src/search-params.ts::SearchParams.sort"] },
    { "file": "test/search-params.test.ts", "name": "builds from an object of lists", "status": "passed",
      "reaches": ["src/search-params.ts::SearchParams.constructor", "src/search-params.ts::SearchParams.toString"] },

    { "file": "test/url.test.ts", "name": "splits a URL into its parts", "status": "passed",
      "reaches": ["src/url.ts::Url.constructor"] },
    { "file": "test/url.test.ts", "name": "resolves a relative path against a base", "status": "passed",
      "reaches": ["src/url.ts::Url.constructor", "src/url.ts::Url.toString", "src/url.ts::Url.resolve", "src/path/normalize.ts::normalizePath"] },
    { "file": "test/url.test.ts", "name": "replaces query parameters and leaves the original alone", "status": "passed",
      "reaches": ["src/url.ts::Url.constructor", "src/url.ts::Url.withQuery"] },
    { "file": "test/url.test.ts", "name": "appends path segments", "status": "passed",
      "reaches": ["src/url.ts::Url.withPath", "src/path/join.ts::joinPaths"] },
    { "file": "test/url.test.ts", "name": "compares URLs after normalizing them", "status": "passed",
      "reaches": ["src/url.ts::Url.constructor", "src/url.ts::Url.equals"] },
    { "file": "test/url.test.ts", "name": "throws on a relative URL with no base", "status": "passed",
      "reaches": ["src/url.ts::Url.constructor", "src/env.ts::currentOrigin", "src/errors.ts::QueryError.constructor"] },
    { "file": "test/url.test.ts", "name": "converts an internationalized host to punycode", "status": "skipped",
      "reaches": ["src/url.ts::Url.constructor"] },

    { "file": "test/relative-url.test.ts", "name": "resolves a relative URL against the page origin", "status": "passed",
      "reaches": ["src/url.ts::Url.constructor", "src/url.ts::Url.toString", "src/url.ts::Url.resolve"] },

    { "file": "test/path.test.ts", "name": "joins %j into %s", "status": "passed",
      "reaches": ["src/path/join.ts::joinPaths"] },
    { "file": "test/path.test.ts", "name": "removes dot segments", "status": "passed",
      "reaches": ["src/path/normalize.ts::normalizePath", "src/path/normalize.ts::removeDotSegments"] },
    { "file": "test/path.test.ts", "name": "matches a path and decodes its parameters", "status": "passed",
      "reaches": ["src/path/template.ts::PathTemplate.constructor", "src/path/template.ts::PathTemplate.match", "src/encode.ts::decodeComponent"] },
    { "file": "test/path.test.ts", "name": "expands parameters into a path", "status": "passed",
      "reaches": ["src/path/template.ts::PathTemplate.constructor", "src/path/template.ts::PathTemplate.expand", "src/encode.ts::encodeComponent"] },
    { "file": "test/path.test.ts", "name": "matches the rest of a path with a star parameter", "status": "passed",
      "reaches": ["src/path/template.ts::PathTemplate.constructor", "src/path/template.ts::PathTemplate.compile", "src/path/template.ts::PathTemplate.match", "src/path/template.ts::PathTemplate.expand"] },
    { "file": "test/path.test.ts", "name": "rejects a star parameter that is not last", "status": "passed",
      "reaches": ["src/path/template.ts::PathTemplate.constructor", "src/path/template.ts::PathTemplate.compile", "src/errors.ts::QueryError.constructor"] }
  ],
  "untested": [
    "src/compat.ts::fromLegacy",
    "src/compat.ts::toLegacy",
    "src/search-params.ts::SearchParams.forEach",
    "src/url.ts::Url.toJSON",
    "src/path/normalize.ts::isSubpath"
  ]
}
