      "reaches": ["src/inventory.cpp::stockroom.Inventory.on_hand"]
    },
    {
      "file": "tests/inventory_test.cpp",
      "name": "a million receipts into one bin",
      "reaches": ["src/inventory.cpp::stockroom.Inventory.receive", "src/inventory.cpp::stockroom.Inventory.on_hand"]
    },
    {
      "file": "tests/location_test.cpp",
