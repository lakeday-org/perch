    },
    {
      "file": "tests/inventory_test.cpp",
      "name": "pick takes from the nearest bin first",
      "reaches": ["src/inventory.cpp::stockroom.Inventory.reserve", "src/inventory.cpp::stockroom.Inventory.pick", "src/inventory.cpp::stockroom.Inventory.on_hand"]
    },
    {
      "file": "tests/inventory_test.cpp",
      "name": "pick refuses stock nobody reserved",
      "reaches": ["src/inventory.cpp::stockroom.Inventory.pick"]
    },
    {
      "file": "tests/inventory_test.cpp",
      "name": "release refuses more than was reserved",
      "reaches": ["src/inventory.cpp::stockroom.Inventory.release", "src/sku.cpp::stockroom.Sku.Sku"]
    },
    {
      "file": "tests/inventory_test.cpp",
