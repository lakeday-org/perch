      "reaches": ["src/location.cpp::stockroom.parse_location"]
    },
    {
      "file": "tests/location_test.cpp",
      "name": "parse_location rejects what is not a bin",
      "reaches": ["src/location.cpp::stockroom.parse_location"]
    },
    {
      "file": "tests/location_test.cpp",
      "name": "format_location pads shelf and slot",
      "reaches": ["src/location.cpp::stockroom.format_location"]
    },
    {
      "file": "tests/location_test.cpp",
      "name": "walk_distance",
      "reaches": ["src/location.cpp::stockroom.walk_distance"]
    },
    {
      "file": "tests/reorder_test.cpp",
      "name": "reorder_quantity follows the policy",
      "reaches": ["src/reorder.cpp::stockroom.reorder_quantity"]
    },
    {
      "file": "tests/reorder_test.cpp",
      "name": "lead-time demand rounds part of a unit up",
      "reaches": ["src/reorder.cpp::stockroom.reorder_quantity"]
    },
    {
      "file": "tests/reorder_test.cpp",
      "name": "round_to_case",
      "reaches": ["src/reorder.cpp::stockroom.round_to_case"]
    },
    {
      "file": "tests/reorder_test.cpp",
      "name": "round_to_case never orders less than a supplier's minimum case",
      "reaches": ["src/reorder.cpp::stockroom.round_to_case"]
    },
    {
      "file": "tests/ring_buffer_test.cpp",
