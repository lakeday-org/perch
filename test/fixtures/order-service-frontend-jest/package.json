{
  "name": "perch-fixture-order-service-frontend-jest",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.tsx --bundle --format=esm --jsx=automatic --outfile=dist/main.js",
    "test": "jest"
  },
  "dependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.27.7",
    "jest": "^30.0.0",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.{ts,tsx}", "!src/**/*.test.tsx"],
    "reporters": ["default", "jest-junit"]
  },
  "jest-junit": {
    "addFileAttribute": "true",
    "ancestorSeparator": " > ",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  }
}
