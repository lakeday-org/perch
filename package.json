{
  "name": "@lakeday/perch",
  "version": "0.1.0",
  "description": "Finds real bugs in a repository, proves each one with a failing regression test, and optionally fixes it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakeday-org/perch.git"
  },
  "bugs": {
    "url": "https://github.com/lakeday-org/perch/issues"
  },
  "homepage": "https://github.com/lakeday-org/perch#readme",
  "type": "module",
  "bin": {
    "perch": "bin/perch.mjs"
  },
  "files": [
    "bin",
    "dist",
    "doc",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "tree-sitter-wasm": "2.0.1",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.27.7",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
