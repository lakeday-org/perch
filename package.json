{
  "name": "@lakeday/perch",
  "version": "0.4.2",
  "description": "Semantic code linting with Jev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakeday-org/perch.git"
  },
  "bugs": {
    "url": "https://github.com/lakeday-org/perch/issues"
  },
  "homepage": "https://github.com/lakeday-org/perch#readme",
  "type": "module",
  "bin": {
    "perch": "bin/perch.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "coverage.yaml",
    "dist",
    "docs",
    "scan.yaml",
    "skill.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fixtures": "npm run build && node scripts/verify-fixtures.mjs",
    "test:coverage": "npm run build && node scripts/verify-coverage.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@xberg-io/tree-sitter-language-pack": "1.21.0",
    "gpt-tokenizer": "4.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.3"
  }
}
